\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Two examples of models in Class 8. Left: Model with coefficients $(-1,-1,-1,-1,1,1)$, where one qubit ($q_3$) has two ferromagnetic interactions. Right: Model with coefficients $(-1,-1,1,-1,1,-1)$, derived by applying an interchange operation on qubits $q_0$ and $q_2$.\relax }}{11}{figure.caption.26}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Coefficients $J_{ij}$ for Class 8 of the Heisenberg Hamiltonian.\relax }}{11}{table.caption.25}\protected@file@percent }
