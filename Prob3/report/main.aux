\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Two examples of models in Class 6. Left: Model with coefficients $(1,-1,1,1,-1,1)$, where each qubit has one anti-ferromagnetic interaction. Right: Model with coefficients $(1,1,-1,-1,1,1)$, derived by applying an interchange operation on qubits $q_0$ and $q_1$.\relax }}{9}{figure.caption.20}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Coefficients $J_{ij}$ for Class 6 of the Heisenberg Hamiltonian.\relax }}{9}{table.caption.19}\protected@file@percent }
\newlabel{tab:example6}{{6}{9}{Coefficients $J_{ij}$ for Class 6 of the Heisenberg Hamiltonian.\relax }{table.caption.19}{}}
\@writefile{toc}{\contentsline {paragraph}{Class 6. }{9}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Figure 7: Two examples of models in Class 7. Left: Model with coefficients $(1,-1,-1,1,-1,1)$, where each qubit has one or two anti-ferromagnetic interactions. Right: Model with coefficients $(1,-1,1,1,-1,-1)$, derived by applying an interchange operation on qubits $q_0$ and $q_2$. The symmetry class also allows sign-flip operations, preserving the class structure.\relax }}{10}{figure.caption.23}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Coefficients $J_{ij}$ for Class 7 of the Heisenberg Hamiltonian.\relax }}{10}{table.caption.22}\protected@file@percent }
