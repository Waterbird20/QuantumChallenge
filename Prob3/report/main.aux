\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Two examples of models in Class 2. Left: Model with coefficients $(1,1,1,1,-1,1)$. Right: Model with coefficients $(1,1,1,1,1,-1)$, derived via qubit interchange. \relax }}{5}{figure.caption.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Coefficients $J_{ij}$ for Class 2 of the Heisenberg Hamiltonian.\relax }}{5}{table.caption.8}\protected@file@percent }
