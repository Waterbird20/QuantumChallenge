\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces The unique model in Class 11, with coefficients $(-1, -1, -1, -1, -1, -1)$. All interactions are anti-ferromagnetic, and no additional elements exist within this class, even under interchange operations. This class can also be derived through sign-flip operations on Class 1 models.\relax }}{14}{figure.caption.35}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Coefficient $J_{ij}$ for Class 11 of the Heisenberg Hamiltonian.\relax }}{14}{table.caption.34}\protected@file@percent }
