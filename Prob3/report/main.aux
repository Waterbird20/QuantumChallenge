\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Eigenspectra of the 11 symmetry classes. Higher energy levels are shown in red tones, while lower energy levels are shown in blue tones. The number of cells at each energy level represents its degeneracy. \relax }}{15}{figure.caption.38}\protected@file@percent }
\newlabel{fig:energylevels}{{12}{15}{Eigenspectra of the 11 symmetry classes. Higher energy levels are shown in red tones, while lower energy levels are shown in blue tones. The number of cells at each energy level represents its degeneracy. \relax }{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Evolution of eigenvalues as a function of the interpolation parameter $s$ for the 11 symmetry classes. Red-tone lines represent higher energy eigenvalues, while violet-tone lines correspond to lower energy levels, including the ground state. \relax }}{17}{figure.caption.42}\protected@file@percent }
\newlabel{fig:Eigenspectra_s}{{13}{17}{Evolution of eigenvalues as a function of the interpolation parameter $s$ for the 11 symmetry classes. Red-tone lines represent higher energy eigenvalues, while violet-tone lines correspond to lower energy levels, including the ground state. \relax }{figure.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Evolution of eigenvalues for the modified Heisenberg spin glass Hamiltonian $H_{sg}$ during adiabatic evolution. The horizontal axis represents the interpolation parameter $s$, while the vertical axis shows energy eigenvalues. Red-tone lines denote higher energy eigenvalues, and blue-tone lines denote lower energy eigenvalues, including the ground state. Notably, the ground state eigenvalue does not cross with any higher energy eigenvalues, ensuring adiabatic evolution without transitions to excited states.\relax }}{18}{figure.caption.44}\protected@file@percent }
\newlabel{fig:adiabatic_H_sg}{{14}{18}{Evolution of eigenvalues for the modified Heisenberg spin glass Hamiltonian $H_{sg}$ during adiabatic evolution. The horizontal axis represents the interpolation parameter $s$, while the vertical axis shows energy eigenvalues. Red-tone lines denote higher energy eigenvalues, and blue-tone lines denote lower energy eigenvalues, including the ground state. Notably, the ground state eigenvalue does not cross with any higher energy eigenvalues, ensuring adiabatic evolution without transitions to excited states.\relax }{figure.caption.44}{}}
