\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Visual representation of a four-qubit system with ferromagnetic interactions. Each blue edge corresponds to a ferromagnetic interaction ($J_{ij}=1$) between qubits $q_i$and $q_j$. The system belongs to Class 1, where all interactions are ferromagnetic.\relax }}{4}{figure.caption.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Coefficients $J_{ij}$ for Class 1 of the Heisenberg Hamiltonian.\relax }}{4}{table.caption.5}\protected@file@percent }
