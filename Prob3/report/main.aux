\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Two examples of models in Class 9. Left: Model with coefficients $(-1,1,-1,-1,1,-1)$, where each qubit has one anti-ferromagnetic interaction. Right: Model with coefficients $(-1,-1,1,1,-1,-1)$, derived by applying an interchange operation on qubits $q_0$ and $q_1$.\relax }}{12}{figure.caption.29}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Coefficients $J_{ij}$ for Class 9 of the Heisenberg Hamiltonian.\relax }}{12}{table.caption.28}\protected@file@percent }
