\PYG{k}{def} \PYG{n+nf}{\PYGZus{}calculate\PYGZus{}expectation}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{basis}\PYG{p}{,} \PYG{n}{i}\PYG{p}{,} \PYG{n}{j}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
  \PYG{n}{expectation\PYGZus{}value} \PYG{o}{=} \PYG{l+m+mi}{0}
