\begin{Verbatim}[commandchars=\\\{\}]
\PYG{k}{def} \PYG{n+nf}{\PYGZus{}Kron}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{array}\PYG{p}{):}
    \PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Calculate the Kronecker product of a list of array.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        tensors : list of np.array.}
\PYG{l+s+sd}{        [A\PYGZus{}0, A\PYGZus{}1, A\PYGZus{}2, ..., A\PYGZus{}N]}
\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        prod: the Kronecker product of the input array.}
\PYG{l+s+sd}{        A\PYGZus{}N ⊗ A\PYGZus{}\PYGZob{}N\PYGZhy{}1\PYGZcb{} ⊗ ... ⊗ A\PYGZus{}1 ⊗ A\PYGZus{}0}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{prod} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}
    \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{array}\PYG{p}{)} \PYG{o}{==} \PYG{l+m+mi}{0}\PYG{p}{:}
        \PYG{k}{return} \PYG{n}{prod}
    \PYG{k}{else}\PYG{p}{:}
        \PYG{k}{for} \PYG{n}{element} \PYG{o+ow}{in} \PYG{n}{array}\PYG{p}{:}
            \PYG{n}{prod} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{kron}\PYG{p}{(}\PYG{n}{element}\PYG{p}{,} \PYG{n}{prod}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{prod}
\end{Verbatim}
